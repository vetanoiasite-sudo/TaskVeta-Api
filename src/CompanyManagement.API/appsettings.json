{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CompanyManagement;Username=postgres"
  },
  "Jwt": {
    "Issuer": "CompanyManagement",
    "Audience": "CompanyManagement.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "SecureCookies": true
  },
  "App": {
    "PublicUrl": "http://localhost:4200"
  },
  "Company": {
    "Name": "Company HQ",
    "TimeZoneId": "",
    "WeekendDays": "Friday,Saturday"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Jobs": {
    "Enabled": true,
    "AttendanceMonitorMinutes": 15,
    "TaskDeadlineMinutes": 10
  },
  "Storage": {
    "UploadsPath": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" } },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
